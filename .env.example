# Default connection resolved by TeqFw_Db_Back_RDb_Connect$.
TEQFW_DB__CLIENT=sqlite3
TEQFW_DB__FILENAME=./var/application.sqlite
TEQFW_DB__USE_NULL_AS_DEFAULT=true

# Optional named connection. The host owns the corresponding application DI token.
TEQFW_DB__REPORTING_CLIENT=pg
TEQFW_DB__REPORTING_HOST=127.0.0.1
TEQFW_DB__REPORTING_PORT=5432
TEQFW_DB__REPORTING_USER=application
TEQFW_DB__REPORTING_PASSWORD=change-me
TEQFW_DB__REPORTING_DATABASE=reporting

# JSON is reserved for uncommon Knex or driver-specific options.
TEQFW_DB__REPORTING_EXTRA='{"pool":{"min":1,"max":4},"connection":{"ssl":true}}'
