{
  "name": "@teqfw/db",
  "version": "2.1.1",
  "description": "Relational database schema, transaction, typed-query, and rebuild package for TeqFW applications using DI 2.x.",
  "type": "module",
  "files": [
    ".env.example",
    "doc/",
    "jsconfig.json",
    "skills/",
    "src/",
    "types.d.ts",
    "LICENSE",
    "CHANGELOG.md",
    "README.md",
    "RELEASE.md"
  ],
  "scripts": {
    "test": "npm run test:unit && npm run test:integration && npm run test:acceptance && npm run test:package",
    "test:unit": "find test/unit -name '*.test.mjs' -print0 | xargs -0 node --test",
    "test:integration": "node --test test/integration/Di2.test.mjs",
    "test:acceptance": "find test/acceptance -name '*.test.mjs' -print0 | xargs -0 node --test",
    "test:package": "find test/package -name '*.test.mjs' -print0 | xargs -0 node --test",
    "typecheck": "tsc -p jsconfig.json",
    "lint:md": "markdownlint-cli2 \"skills/**/*.md\" \"*.md\"",
    "test:optin": "npm run test:optin:preflight && npm run test:optin:postgresql && npm run test:optin:mariadb",
    "test:optin:preflight": "node --test test/optin/Preflight.test.mjs",
    "test:optin:postgresql": "node --test test/optin/Postgresql.test.mjs",
    "test:optin:mariadb": "node --test test/optin/Mysql.test.mjs",
    "test:manual": "find test/manual -name '*.test.mjs' -print0 | xargs -r -0 node --test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teqfw/db.git"
  },
  "keywords": [
    "database",
    "teqfw",
    "knex",
    "rdbms",
    "tequila framework",
    "es6",
    "node.js",
    "db-connector"
  ],
  "author": {
    "name": "Alex Gusev",
    "email": "alex@flancer64.com",
    "url": "https://github.com/flancer64"
  },
  "license": "Apache-2.0",
  "types": "types.d.ts",
  "exports": {
    ".": {
      "types": "./types.d.ts"
    }
  },
  "bugs": {
    "url": "https://github.com/teqfw/db/issues"
  },
  "homepage": "https://github.com/teqfw/db#readme",
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/teqfw"
  },
  "dependencies": {
    "@teqfw/cfg": "^2.0.0",
    "@teqfw/log": ">=2.0.0",
    "knex": "^3.1.0"
  },
  "devDependencies": {
    "@teqfw/di": "^2.7.0",
    "@types/node": "^22.20.1",
    "markdownlint-cli2": "^0.23.2",
    "mysql2": "^3.12.0",
    "pg": "^8.13.1",
    "sqlite3": "^6.0.1",
    "typescript": "^5.9.3",
    "typescript-language-server": "^4.4.1"
  },
  "engines": {
    "node": ">=20.17.0"
  },
  "peerDependencies": {
    "@teqfw/di": "^2.7.0"
  },
  "teqfw": {
    "fw": {
      "di": {
        "namespaces": [
          {
            "prefix": "TeqFw_Db_",
            "path": "./src",
            "ext": ".mjs"
          }
        ]
      }
    }
  }
}
