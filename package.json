{
  "name": "@teqfw/db",
  "version": "2.0.0",
  "description": "Relational database schema, transaction, and CRUD package for TeqFW applications using DI 2.x.",
  "type": "module",
  "files": [
    "src/",
    "doc/"
  ],
  "scripts": {
    "test": "npm run test:module && npm run test:integration && npm run test:acceptance",
    "test:module": "mocha --recursive \"test/mod/**/*.test.mjs\"",
    "test:integration": "mocha --recursive \"test/integration/**/*.test.mjs\"",
    "test:acceptance": "mocha --recursive \"test/accept/**/*.test.mjs\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teqfw/db.git"
  },
  "keywords": [
    "database",
    "knex",
    "rdbms",
    "crud",
    "tequila framework",
    "es6",
    "node.js",
    "db-connector"
  ],
  "author": "Alex Gusev <alex@flancer64.com>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/teqfw/db/issues"
  },
  "homepage": "https://github.com/teqfw/db#readme",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/teqfw"
  },
  "dependencies": {
    "@teqfw/log": "^0.1.0",
    "knex": "^3.1.0"
  },
  "devDependencies": {
    "@teqfw/di": "^2.7.0",
    "mocha": "^11.0.1",
    "mysql2": "^3.12.0",
    "pg": "^8.13.1",
    "sqlite3": "^5.1.7"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@teqfw/di": "^2.7.0"
  },
  "teqfw": {
    "namespaces": [
      {
        "prefix": "TeqFw_Db_",
        "path": "./src",
        "ext": ".mjs"
      }
    ]
  }
}
