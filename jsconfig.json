{
  "compilerOptions": {
    "checkJs": true,
    "forceConsistentCasingInFileNames": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "maxNodeModuleJsDepth": 0,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "types": [
      "node"
    ]
  },
  "include": [
    "src",
    "test/package/types",
    "types.d.ts",
    "node_modules/@teqfw/*/types.d.ts",
    "node_modules/@teqfw/*/src"
  ],
  "exclude": [
    "dist"
  ]
}
