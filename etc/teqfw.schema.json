{
  "version": 2,
  "namespace": "teqfw.db.schema",
  "entity": {
        "snapshot": {
          "attr": {
            "created_at": {
              "default": {
                "kind": "function",
                "name": "core.currentTimestamp"
              },
              "type": {
                "id": "core.datetime"
              }
            },
            "dem": {
              "type": {
                "id": "core.text"
              }
            },
            "fingerprint": {
              "type": {
                "id": "core.string",
                "params": {
                  "length": 96
                }
              }
            },
            "id": {
              "type": {
                "id": "core.identity"
              }
            },
            "provenance": {
              "type": {
                "id": "core.text"
              }
            }
          },
          "index": {
            "fingerprint": {
              "keys": [
                {
                  "attr": "fingerprint"
                }
              ],
              "kind": "unique",
              "phase": "table"
            }
          }
        },
        "application": {
          "attr": {
            "completed_at": {
              "nullable": true,
              "type": {
                "id": "core.datetime"
              }
            },
            "id": {
              "type": {
                "id": "core.identity"
              }
            },
            "source_snapshot_id": {
              "nullable": true,
              "type": {
                "id": "core.ref"
              }
            },
            "started_at": {
              "default": {
                "kind": "function",
                "name": "core.currentTimestamp"
              },
              "type": {
                "id": "core.datetime"
              }
            },
            "status": {
              "type": {
                "id": "core.enum",
                "params": {
                  "values": [
                    "started",
                    "applied",
                    "failed"
                  ]
                }
              }
            },
            "target_snapshot_id": {
              "type": {
                "id": "core.ref"
              }
            }
          },
          "relation": {
            "source": {
              "action": {
                "delete": "restrict",
                "update": "cascade"
              },
              "attrs": [
                "source_snapshot_id"
              ],
              "deferrable": "notDeferrable",
              "ref": {
                "attrs": [
                  "id"
                ],
                "path": "/snapshot"
              }
            },
            "target": {
              "action": {
                "delete": "restrict",
                "update": "cascade"
              },
              "attrs": [
                "target_snapshot_id"
              ],
              "deferrable": "notDeferrable",
              "ref": {
                "attrs": [
                  "id"
                ],
                "path": "/snapshot"
              }
            }
          }
        }
  }
}
